{
  "resourceType": "StructureDefinition",
  "id": "ks-maturity-observation",
  "url": "http://example.org/fhir/kitchen-sink/StructureDefinition/ks-maturity-observation",
  "version": "0.2.0",
  "name": "MaturityObservation",
  "title": "Interoperability Maturity Observation",
  "status": "active",
  "experimental": true,
  "date": "2026-11-20",
  "publisher": "The Committee for Doing It Properly",
  "description": "An observation of the interoperability maturity of a patient's data, as assessed by someone who has read the specification.",
  "fhirVersion": "5.0.0",
  "kind": "resource",
  "abstract": false,
  "type": "Observation",
  "baseDefinition": "http://hl7.org/fhir/StructureDefinition/Observation",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Observation",
        "path": "Observation",
        "short": "A maturity assessment"
      },
      {
        "id": "Observation.code",
        "path": "Observation.code",
        "patternCodeableConcept": {
          "coding": [
            {
              "system": "http://example.org/fhir/kitchen-sink/CodeSystem/assessment-kinds",
              "code": "maturity-assessment"
            }
          ]
        }
      },
      {
        "id": "Observation.subject",
        "path": "Observation.subject",
        "min": 1,
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "http://example.org/fhir/kitchen-sink/StructureDefinition/ks-patient"
            ]
          }
        ]
      },
      {
        "id": "Observation.value[x]",
        "path": "Observation.value[x]",
        "min": 1,
        "type": [
          {
            "code": "CodeableConcept"
          }
        ],
        "mustSupport": true,
        "extension": [
          {
            "url": "http://hl7.org/fhir/StructureDefinition/obligation",
            "extension": [
              {
                "url": "code",
                "valueCode": "SHALL:populate-if-known"
              },
              {
                "url": "actor",
                "valueCanonical": "http://example.org/fhir/kitchen-sink/ActorDefinition/vendor-next-quarter"
              },
              {
                "url": "documentation",
                "valueMarkdown": "The level the vendor claims."
              }
            ]
          },
          {
            "url": "http://hl7.org/fhir/StructureDefinition/obligation",
            "extension": [
              {
                "url": "code",
                "valueCode": "SHALL:display"
              },
              {
                "url": "actor",
                "valueCanonical": "http://example.org/fhir/kitchen-sink/ActorDefinition/conformant-client"
              },
              {
                "url": "documentation",
                "valueMarkdown": "Displayed without editorial comment."
              }
            ]
          }
        ],
        "binding": {
          "strength": "required",
          "valueSet": "http://example.org/fhir/kitchen-sink/ValueSet/maturity-levels",
          "additional": [
            {
              "purpose": "candidate",
              "valueSet": "http://example.org/fhir/kitchen-sink/ValueSet/production-ready",
              "documentation": "The levels a future version of this guide intends to require, eventually.",
              "shortDoco": "future requirement"
            },
            {
              "purpose": "ui",
              "valueSet": "http://example.org/fhir/kitchen-sink/ValueSet/maturity-levels",
              "shortDoco": "for pick lists"
            }
          ]
        }
      },
      {
        "id": "Observation.component",
        "path": "Observation.component",
        "slicing": {
          "discriminator": [
            {
              "type": "pattern",
              "path": "code"
            }
          ],
          "rules": "open"
        }
      },
      {
        "id": "Observation.component:excuse",
        "path": "Observation.component",
        "sliceName": "excuse",
        "min": 0,
        "max": "1",
        "short": "The excuse offered for the observed level"
      },
      {
        "id": "Observation.component:excuse.code",
        "path": "Observation.component.code",
        "patternCodeableConcept": {
          "coding": [
            {
              "system": "http://example.org/fhir/kitchen-sink/CodeSystem/assessment-kinds",
              "code": "excuse"
            }
          ]
        }
      },
      {
        "id": "Observation.component:excuse.value[x]",
        "path": "Observation.component.value[x]",
        "type": [
          {
            "code": "CodeableConcept"
          }
        ],
        "binding": {
          "strength": "extensible",
          "valueSet": "http://example.org/fhir/kitchen-sink/ValueSet/excuses"
        }
      }
    ]
  }
}