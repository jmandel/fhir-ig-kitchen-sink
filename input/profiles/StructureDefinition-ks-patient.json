{
  "resourceType": "StructureDefinition",
  "id": "ks-patient",
  "extension": [
    {
      "url": "http://hl7.org/fhir/StructureDefinition/structuredefinition-imposeProfile",
      "valueCanonical": "http://example.org/fhir/kitchen-sink/StructureDefinition/ks-minimal-patient"
    },
    {
      "url": "http://hl7.org/fhir/StructureDefinition/structuredefinition-compliesWithProfile",
      "valueCanonical": "http://example.org/fhir/kitchen-sink/StructureDefinition/ks-minimal-patient"
    }
  ],
  "url": "http://example.org/fhir/kitchen-sink/StructureDefinition/ks-patient",
  "version": "0.2.0",
  "name": "KitchenSinkPatient",
  "title": "Kitchen Sink Patient",
  "_title": {
    "extension": [
      {
        "url": "http://hl7.org/fhir/StructureDefinition/translation",
        "extension": [
          {
            "url": "lang",
            "valueCode": "de"
          },
          {
            "url": "content",
            "valueString": "Küchenspülen-Patient"
          }
        ]
      }
    ]
  },
  "status": "active",
  "experimental": true,
  "date": "2026-11-20",
  "publisher": "The Committee for Doing It Properly",
  "description": "A Patient as exchanged The Right Way: identified, named, and annotated with the excuse that explains whatever is missing. Imposes the minimal patient profile, because every profile eventually imposes another profile.",
  "fhirVersion": "5.0.0",
  "mapping": [
    {
      "identity": "excuse-tracker",
      "uri": "http://example.org/excuse-tracker",
      "name": "Excuse Tracker Spreadsheet",
      "comment": "Column names in the spreadsheet that every project keeps alongside the real system."
    },
    {
      "identity": "rim",
      "uri": "http://hl7.org/v3",
      "name": "RIM Mapping"
    }
  ],
  "kind": "resource",
  "abstract": false,
  "type": "Patient",
  "baseDefinition": "http://example.org/fhir/kitchen-sink/StructureDefinition/ks-minimal-patient",
  "derivation": "constraint",
  "differential": {
    "element": [
      {
        "id": "Patient",
        "path": "Patient",
        "short": "A patient, exchanged properly",
        "mapping": [
          {
            "identity": "excuse-tracker",
            "map": "Sheet 'Patients (final) (2)'"
          }
        ]
      },
      {
        "id": "Patient.extension",
        "path": "Patient.extension",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "url"
            }
          ],
          "rules": "open"
        }
      },
      {
        "id": "Patient.extension:excuse",
        "path": "Patient.extension",
        "sliceName": "excuse",
        "short": "Why this record is the way it is",
        "min": 0,
        "max": "1",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "http://example.org/fhir/kitchen-sink/StructureDefinition/ext-excuse"
            ]
          }
        ],
        "mustSupport": true,
        "extension": [
          {
            "url": "http://hl7.org/fhir/StructureDefinition/obligation",
            "extension": [
              {
                "url": "code",
                "valueCode": "SHALL:populate-if-known"
              },
              {
                "url": "actor",
                "valueCanonical": "http://example.org/fhir/kitchen-sink/ActorDefinition/vendor-next-quarter"
              },
              {
                "url": "documentation",
                "valueMarkdown": "Populated whenever an excuse has been formally offered."
              }
            ]
          },
          {
            "url": "http://hl7.org/fhir/StructureDefinition/obligation",
            "extension": [
              {
                "url": "code",
                "valueCode": "SHALL:handle"
              },
              {
                "url": "actor",
                "valueCanonical": "http://example.org/fhir/kitchen-sink/ActorDefinition/integration-engine"
              },
              {
                "url": "documentation",
                "valueMarkdown": "Passed through unchanged; the engine does not judge."
              }
            ]
          },
          {
            "url": "http://hl7.org/fhir/StructureDefinition/obligation",
            "extension": [
              {
                "url": "code",
                "valueCode": "SHOULD:display"
              },
              {
                "url": "actor",
                "valueCanonical": "http://example.org/fhir/kitchen-sink/ActorDefinition/conformant-client"
              },
              {
                "url": "documentation",
                "valueMarkdown": "Shown to the user, who deserves to know."
              }
            ]
          }
        ],
        "mapping": [
          {
            "identity": "excuse-tracker",
            "map": "Column E 'Reason (see email)'"
          }
        ]
      },
      {
        "id": "Patient.extension:workaround",
        "path": "Patient.extension",
        "sliceName": "workaround",
        "short": "The workaround currently in place",
        "min": 0,
        "max": "*",
        "type": [
          {
            "code": "Extension",
            "profile": [
              "http://example.org/fhir/kitchen-sink/StructureDefinition/ext-workaround"
            ]
          }
        ]
      },
      {
        "id": "Patient.identifier",
        "path": "Patient.identifier",
        "slicing": {
          "discriminator": [
            {
              "type": "value",
              "path": "system"
            }
          ],
          "rules": "open"
        },
        "min": 1,
        "mustSupport": true,
        "extension": [
          {
            "url": "http://hl7.org/fhir/StructureDefinition/obligation",
            "extension": [
              {
                "url": "code",
                "valueCode": "SHALL:populate-if-known"
              },
              {
                "url": "actor",
                "valueCanonical": "http://example.org/fhir/kitchen-sink/ActorDefinition/vendor-next-quarter"
              },
              {
                "url": "documentation",
                "valueMarkdown": "At least one identifier, even if it is the row number in the spreadsheet."
              }
            ]
          }
        ]
      },
      {
        "id": "Patient.identifier:ticket",
        "path": "Patient.identifier",
        "sliceName": "ticket",
        "short": "The ticket explaining this record",
        "min": 0,
        "max": "1"
      },
      {
        "id": "Patient.identifier:ticket.system",
        "path": "Patient.identifier.system",
        "min": 1,
        "patternUri": "http://example.org/fhir/kitchen-sink/NamingSystem/vendor-ticket"
      },
      {
        "id": "Patient.identifier:ticket.value",
        "path": "Patient.identifier.value",
        "min": 1
      },
      {
        "id": "Patient.name",
        "path": "Patient.name",
        "min": 1,
        "type": [
          {
            "code": "HumanName",
            "profile": [
              "http://example.org/fhir/kitchen-sink/StructureDefinition/ks-humanname"
            ]
          }
        ],
        "mustSupport": true,
        "extension": [
          {
            "url": "http://hl7.org/fhir/StructureDefinition/obligation",
            "extension": [
              {
                "url": "code",
                "valueCode": "SHALL:populate-if-known"
              },
              {
                "url": "actor",
                "valueCanonical": "http://example.org/fhir/kitchen-sink/ActorDefinition/vendor-next-quarter"
              },
              {
                "url": "documentation",
                "valueMarkdown": "Populated from the registration system, in whatever order it stores names."
              }
            ]
          },
          {
            "url": "http://hl7.org/fhir/StructureDefinition/obligation",
            "extension": [
              {
                "url": "code",
                "valueCode": "SHALL:display"
              },
              {
                "url": "actor",
                "valueCanonical": "http://example.org/fhir/kitchen-sink/ActorDefinition/conformant-client"
              },
              {
                "url": "documentation",
                "valueMarkdown": "Displayed, with family name first or last depending on the locale and the developer."
              }
            ]
          }
        ],
        "mapping": [
          {
            "identity": "excuse-tracker",
            "map": "Columns B and C, occasionally swapped"
          },
          {
            "identity": "rim",
            "map": "player[classCode=PSN].name"
          }
        ]
      },
      {
        "id": "Patient.gender",
        "path": "Patient.gender",
        "mustSupport": true,
        "extension": [
          {
            "url": "http://hl7.org/fhir/StructureDefinition/obligation",
            "extension": [
              {
                "url": "code",
                "valueCode": "SHALL:no-error"
              },
              {
                "url": "actor",
                "valueCanonical": "http://example.org/fhir/kitchen-sink/ActorDefinition/integration-engine"
              },
              {
                "url": "documentation",
                "valueMarkdown": "Accepted in every form it arrives in."
              }
            ]
          }
        ]
      },
      {
        "id": "Patient.birthDate",
        "path": "Patient.birthDate",
        "mustSupport": true,
        "mapping": [
          {
            "identity": "excuse-tracker",
            "map": "Column D (formatted as text to prevent auto-correction)"
          }
        ]
      },
      {
        "id": "Patient.deceased[x]",
        "path": "Patient.deceased[x]",
        "max": "0"
      },
      {
        "id": "Patient.managingOrganization",
        "path": "Patient.managingOrganization",
        "type": [
          {
            "code": "Reference",
            "targetProfile": [
              "http://hl7.org/fhir/StructureDefinition/Organization"
            ]
          }
        ]
      }
    ]
  }
}