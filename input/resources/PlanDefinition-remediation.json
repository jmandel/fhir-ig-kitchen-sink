{
  "resourceType": "PlanDefinition",
  "id": "remediation",
  "url": "http://example.org/fhir/kitchen-sink/PlanDefinition/remediation",
  "name": "RemediationPlan",
  "title": "Conformance Remediation Plan",
  "version": "0.2.0",
  "status": "active",
  "experimental": true,
  "date": "2026-11-20",
  "publisher": "The Committee for Doing It Properly",
  "description": "What to do when a system is found not to conform: escalate, then wait.",
  "type": {
    "coding": [
      {
        "system": "http://terminology.hl7.org/CodeSystem/plan-definition-type",
        "code": "eca-rule"
      }
    ]
  },
  "library": [
    "http://example.org/fhir/kitchen-sink/Library/excuse-logic"
  ],
  "action": [
    {
      "title": "Escalate the gap",
      "description": "Open a ticket with the vendor, referencing the requirement that was not met.",
      "condition": [
        {
          "kind": "applicability",
          "expression": {
            "language": "text/fhirpath",
            "expression": "%subject.extension('http://example.org/fhir/kitchen-sink/StructureDefinition/ext-excuse').exists()",
            "description": "An excuse has been recorded"
          }
        }
      ],
      "definitionCanonical": "http://example.org/fhir/kitchen-sink/ActivityDefinition/escalate"
    },
    {
      "title": "Wait one quarter",
      "description": "Wait for the next quarter, then repeat."
    }
  ]
}