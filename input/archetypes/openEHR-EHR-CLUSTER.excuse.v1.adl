	details = <
		["en"] = <
			language = <[ISO_639-1::en]>
			purpose = <"To record an excuse offered for a deviation from an interface specification, in a form that can be queried later.">
			use = <"Use wherever an excuse is offered. Excuses are offered everywhere.">
			keywords = <"excuse, conformance, roadmap", ...>
			misuse = <"Not to be used to record the actual reason, which is out of scope.">
		>
	>

definition
	CLUSTER[id1] matches {	-- Excuse
		items matches {
			ELEMENT[id2] matches {	-- Excuse text
				value matches {
					DV_TEXT[id5] 
				}
			}
			ELEMENT[id3] occurrences matches {0..1} matches {	-- Offered
				value matches {
					DV_DATE_TIME[id6] 
				}
			}
			ELEMENT[id4] occurrences matches {0..1} matches {	-- Believed
				value matches {
					DV_BOOLEAN[id7] 
				}
			}
		}
	}

terminology
	term_definitions = <
		["en"] = <
			["id1"] = <
				text = <"Excuse">
				description = <"An excuse offered for a deviation from an interface specification.">
